PORT=4173
SMARTREAD_DEPLOYMENT=web
# Desktop app overrides this automatically:
# SMARTREAD_DEPLOYMENT=desktop
# SMARTREAD_DATA_DIR=

# Native mobile shells call a deployed API. Use HTTPS in production.
# SMARTREAD_ALLOWED_ORIGINS=https://localhost,capacitor://localhost
# SMARTREAD_COOKIE_SAMESITE=none
# SMARTREAD_COOKIE_SECURE=1
# SMARTREAD_NATIVE_API_BASE_URL=https://your-api.example.com

SMARTREAD_EMAIL_PROVIDER=worker
SMARTREAD_WORKER_MAIL_BASE_URL=https://mail.example.com
SMARTREAD_WORKER_MAIL_PATH=/admin/send_mail
SMARTREAD_WORKER_MAIL_AUTH_HEADER=x-admin-auth
SMARTREAD_WORKER_MAIL_AUTH_TOKEN=replace-with-worker-admin-token
SMARTREAD_WORKER_MAIL_FROM=noreply@example.com
SMARTREAD_WORKER_MAIL_FROM_NAME=智读 SmartRead
SMARTREAD_EMAIL_WHITELIST=gmail.com,163.com,126.com,qq.com,outlook.com,hotmail.com,icloud.com,yahoo.com,foxmail.com

ZLIB_DOMAIN=https://z-lib.fm
ZLIB_LOGIN_DOMAIN=https://z-lib.fm/rpc.php
ZLIB_MIRRORS=https://z-lib.fm,https://z-library.sk,https://z-library.is
ZLIB_EGRESS_MODE=auto
# Optional local Clash/Mihomo control for desktop or private server deployments.
# This is not required for normal web deployments.
# ZLIB_CLASH_API_URL=http://127.0.0.1:9091
# ZLIB_CLASH_API_SECRET=
# ZLIB_CLASH_PROXY_URL=http://127.0.0.1:7890
# ZLIB_CLASH_SELECTOR=🚀 节点选择
# ZLIB_CLASH_PREFERRED_GROUP=🇯🇵 日本优选
# ZLIB_CLASH_SWITCH_TTL_MS=30000

# Server-side proxy pool for deployment. Put Japan proxies first or label them with 日本/JP/Japan.
# Examples:
# ZLIB_PROXY_URLS=日本优选=http://proxy.example.com:7890,新加坡=http://proxy2.example.com:7890
# ZLIB_PROXY_URLS=socks5://user:pass@proxy.example.com:1080#JP
ZLIB_PROXY_URLS=
ZLIB_PROXY_PREFER_KEYWORDS=日本,jp,japan
ZLIB_MIRROR_PROBE_TIMEOUT_MS=8000
ZLIB_MIRROR_CACHE_TTL_MS=300000
ZLIB_TIMEOUT_MS=60000
SMARTREAD_AI_TIMEOUT_MS=60000
