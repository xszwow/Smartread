# Copy this file outside the repo or to android/keystore.properties for local signing.
# Do not commit real passwords or production keystores.
#
# Environment variable alternative:
#   ANDROID_KEYSTORE_PROPERTIES=C:\secure\smartread-release.properties
#   or ANDROID_STORE_FILE / ANDROID_STORE_PASSWORD / ANDROID_KEY_ALIAS / ANDROID_KEY_PASSWORD

storeFile=../certs/smartread-release.jks
storePassword=change-me
keyAlias=smartread
keyPassword=change-me
